# Copy these names into Railway → service → Variables. Never commit real values.
BOT_TOKEN=            # from @BotFather
DATABASE_URL=         # Supabase → Connect → Session pooler connection string
TEAM_CHAT_ID=         # (may be empty on first launch) team group ID (send /id in the group), e.g. -1001234567890
ADMIN_IDS=            # (may be empty on first launch) comma-separated Telegram user IDs of the team (send /id to the bot)
CRYPTO_PAY_TOKEN=     # optional, from @CryptoBot → Crypto Pay → Create App
CRYPTO_PAY_TESTNET=   # "true" to test with @CryptoTestnetBot
